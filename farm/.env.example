# Copy this file to .env and fill in real values for production.
# In development none of this is required - OTP codes print to the console.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave as console backend for local dev (OTPs print in the terminal).
# Switch to django.core.mail.backends.smtp.EmailBackend for real email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Miginon Farm <no-reply@miginonfarm.com>
