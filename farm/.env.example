# Copy this file to .env and fill in real values - .env is gitignored and
# should never contain real secrets in version control.
# In development you can leave EMAIL_BACKEND as the console backend and
# every email (OTP codes, welcome, reports, etc.) will just print to the
# terminal instead of actually sending.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Zoho Mail SMTP. Generate an app-specific password in Zoho Mail ->
# Settings -> Security -> App Passwords if your account has 2FA enabled -
# a regular login password won't authenticate over SMTP in that case.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@farmiq.solutions
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Farm IQ <info@farmiq.solutions>
